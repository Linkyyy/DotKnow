<Application x:Class="TypeLingo.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Styles/Win11.xaml" /></ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="CanvasBrush" Color="#F3F3F3" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CardBrush" Color="#FBFBFB" />
      <SolidColorBrush x:Key="BorderBrush" Color="#E5E5E5" />
      <SolidColorBrush x:Key="HoverBrush" Color="#F5F5F5" />
      <SolidColorBrush x:Key="SelectionBrush" Color="#E9E9E9" />
      <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A" />
      <SolidColorBrush x:Key="MutedBrush" Color="#666666" />
      <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
      <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#E7F1FB" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
