  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Assets/Icons.xaml" /><ResourceDictionary Source="Styles/Win11.xaml" /></ResourceDictionary.MergedDictionaries>
