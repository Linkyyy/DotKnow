      <SolidColorBrush x:Key="BorderBrush" Color="#E5E5E5" />
      <SolidColorBrush x:Key="HoverBrush" Color="#F5F6F7" />
      <SolidColorBrush x:Key="SelectionBrush" Color="#EBEEF1" />
      <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A" />
      <SolidColorBrush x:Key="MutedBrush" Color="#666666" />
      <SolidColorBrush x:Key="AccentBrush" Color="#17191D" />
      <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#F5F6F7" />
