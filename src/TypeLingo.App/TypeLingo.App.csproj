<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TypeLingo</AssemblyName>
    <Version>0.3.0</Version>
    <ApplicationIcon>Assets/typelingo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../TypeLingo.Infrastructure/TypeLingo.Infrastructure.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup><Resource Include="Assets/typelingo.ico" /><Using Remove="System.Windows.Forms" /><Using Remove="System.Drawing" /></ItemGroup>
</Project>
