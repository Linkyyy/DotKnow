cResource MutedBrush}"/></Border></StackPanel>
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:TypeLingo.App.Controls" x:Name="PageHotkeys" Visibility="Collapsed"><controls:SettingCard Title="{DynamicResource '显示翻译预览'}" Description="{DynamicResource '默认 Ctrl+Alt+T；优先翻译选区，否则翻译当前输入框'}"><TextBox x:Name="PreviewHotkey" Width="210" AutomationProperties.Name="{DynamicResource '显示翻译预览'}"/></controls:SettingCard><TextBlock Text="{DynamicResource '全局快捷键'}" Style="{StaticResource SectionHeading}"/><controls:SettingCard Title="{DynamicResource '准备替换 / 显示确认'}" Description="{DynamicResource '打开原文与译文确认，确认后才写入'}"><TextBox x:Name="ReplaceHotkey" Width="240" AutomationProperties.Name="{DynamicResource '准备替换 / 显示确认'}"/></controls:SettingCard><controls:SettingCard Title="{DynamicResource '开启 / 暂停全部读取'}"><TextBox x:Name="ToggleHotkey" Width="240" AutomationProperties.Name="{DynamicResource '开启 / 暂停全部读取'}"/></controls:SettingCard><controls:SettingCard Title="{DynamicResource '复制当前译文'}"><TextBox x:Name="CopyHotkey" Width="240" AutomationProperties.Name="{DynamicResource '复制当前译文'}"/></controls:SettingCard><Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,14,0,0"><TextBlock Text="{DynamicResource '格式：Ctrl+Alt+Enter，可使用 Shift / Win。冲突会明确提示；不会监听所有按键。复制操作会按你的要求覆盖剪贴板；软件不会自动粘贴或模拟 Enter。'}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></Border></StackPanel>
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:TypeLingo.App.Controls" x:Name="PagePrivacy" Visibility="Collapsed"><TextBlock Text="{DynamicResource '应用访问'}" Style="{StaticResource SectionHeading}"/><controls:SettingCard Title="{DynamicResource '监控所有应用'}" Description="{DynamicResource '覆盖全部可访问应用，无需逐一添加进程'}"><CheckBox x:Name="AllApplicationsCheck" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="{DynamicResource '监控所有应用'}" Checked="Scope_Changed" Unchecked="Scope_Changed"/></controls:SettingCard><controls:SettingCard x:Name="AllowedApplicationsCard" Title="{DynamicResource '允许的进程名'}" Description="{DynamicResource '关闭所有应用模式后，仅监控此列表'}"><TextBox x:Name="AllowedInput" Width="240" AutomationProperties.Name="{DynamicResource '允许的进程名'}" Height="80" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></controls:SettingCard><controls:SettingCard Title="{DynamicResource '排除的进程名'}" Description="{DynamicResource '始终优先排除；用逗号或换行分隔进程名'}"><TextBox x:Name="ExcludedInput" Width="240" AutomationProperties.Name="{DynamicResource '排除的进程名'}" Height="80" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/></controls:SettingCard><TextBlock Text="{DynamicResource '授权与保护'}" Style="{StaticResource SectionHeading}"/><controls:SettingCard Title="{DynamicResource '隐私授权'}" Description="{DynamicResource '启用前明确同意将当前输入框内容发送给所选 AI'}"><CheckBox x:Name="ConsentCheck" MaxWidth="270" AutomationProperties.Name="{DynamicResource '隐私授权'}"><TextBlock Text="{DynamicResource '我同意上传输入内容用于翻译'}" FontSize="13"/></CheckBox></controls:SettingCard><controls:SettingCard Title="{DynamicResource '暂停所有读取'}" Description="{DynamicResource '立即停止监控与翻译，并隐藏悬浮窗'}"><Button Content="{DynamicResource '立即暂停'}" Click="Pause_Click"/></controls:SettingCard><Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,14,0,0"><TextBlock Text="{DynamicResource '密码框、敏感控件和排除列表始终跳过。所有应用模式只覆盖系统无障碍接口允许访问的输入框，不会提权或绕过其他程序的安全限制。'}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></Border><Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,14,0,0"><TextBlock Text="{DynamicResource '开启全部应用监控后，可访问输入框的完整内容可能发送给所选 AI 服务。处理私人内容时可随时暂停，也可以切换回仅允许指定应用。'}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></Border></StackPanel></Grid></ScrollViewer><Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,8,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="MessageText" FontSize="12" Foreground="{DynamicResource TextBrush}" Margin="0,0,10,2"/><TextBlock Text="{DynamicResource '更改设置后点击保存；关闭窗口仍在托盘运行'}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel><Button x:Name="SaveSettingsButton" Grid.Column="1" Content="{DynamicResource '保存设置'}" Click="Save_Click" Style="{StaticResource PrimaryButton}" MinWidth="92" Margin="14,0,0,0"/></Grid></Border></Grid>
</Grid></Grid></Border></Window>
