ource '最大输入字符数'}" Description="{DynamicResource '超过长度限制时跳过翻译'}"><TextBox x:Name="MaxInput" Width="72" AutomationProperties.Name="{DynamicResource '最大输入字符数'}"/></controls:SettingCard></StackPanel>
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:TypeLingo.App.Controls" x:Name="PageAi" Visibility="Collapsed"><TextBlock Text="{DynamicResource '服务与模型'}" Style="{StaticResource SectionHeading}"/><controls:SettingCard Title="{DynamicResource 'API 服务商'}" Description="{DynamicResource '五家主流服务，模型由你选择'}"><ComboBox x:Name="ProviderInput" Width="180" AutomationProperties.Name="{DynamicResource 'API 服务商'}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectionChanged="Provider_SelectionChanged"/></controls:SettingCard><controls:SettingCard Title="{DynamicResource '模型'}" Description="{DynamicResource '从账户列表选择，或手动输入模型 ID'}"><ComboBox x:Name="ModelInput" Width="180" AutomationProperties.Name="{DynamicResource '模型'}" IsEditable="True" IsTextSearchEnabled="False"/></controls:SettingCard><controls:SettingCard Title="{DynamicResource 'API 地址'}" Description="{DynamicResource '使用 HTTPS，可连接所选平台的自定义兼容地址'}"><TextBox x:Name="BaseUrlInput" Width="240" AutomationProperties.Name="{DynamicResource 'API 地址'}" TextChanged="BaseUrl_TextChanged"/></controls:SettingCard><TextBlock Text="{DynamicResource '账户与连接'}" Style="{StaticResource SectionHeading}"/><controls:SettingCard Title="{DynamicResource 'API 密钥'}" Description="{DynamicResource '按服务商和地址分别加密保存；留空保留已有密钥'}"><StackPanel Width="240"><PasswordBox x:Name="KeyInput" AutomationProperties.Name="{DynamicResource 'API 密钥'}"/><TextBlock x:Name="KeyStatus" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,7,0,0"/></StackPanel></controls:SettingCard><controls:SettingCard Title="{DynamicResource '官方 API 平台'}" Description="{DynamicResource '前往官方平台获取密钥、管理额度与账单'}"><StackPanel Width="240"><Button Content="{DynamicResource '开通 / 购买 API'}" Click="Platform_Click"/><TextBlock x:Name="PlatformAddress" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/></StackPanel></controls:SettingCard><controls:SettingCard Title="{DynamicResource '连接测试'}" Description="{DynamicResource '模型查询不上传输入；翻译测试只发送 Hello'}"><WrapPanel Width="240"><Button Content="{DynamicResource '查询可用模型'}" Click="Test_Click" x:Name="TestButton" Margin="0,3,6,3"/><Button Content="{DynamicResource '测试翻译（固定短句）'}" Click="TranslateTest_Click" x:Name="TranslateTestButton" Margin="0,3,0,3"/></WrapPanel></controls:SettingCard><TextBlock x:Name="TestStatus" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="12,8,0,4"/><controls:SettingCard Title="{DynamicResource '删除当前服务商的密钥'}" Description="{DynamicResource '仅删除当前服务商与 API 地址的本地密钥'}"><Button Content="{DynamicResource '删除密钥'}" Click="DeleteKey_Click"/></controls:SettingCard><TextBlock Text="{DynamicResource '请求控制'}" Style="{StaticResource SectionHeading}"/><controls:SettingCard Title="{DynamicResource '请求超时（秒）'}"><TextBox x:Name="TimeoutInput" Width="72" AutomationProperties.Name="{DynamicResource '请求超时（秒）'}"/></controls:SettingCard><controls:SettingCard Title="{DynamicResource '429 / 5xx 最大重试次数'}" Description="{DynamicResource '仅对限流与临时服务错误进行有限重试'}"><TextBox x:Name="RetriesInput" Width="72" AutomationProperties.Name="{DynamicResource '429 / 5xx 最大重试次数'}"/></controls:SettingCard><Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,14,0,0"><TextBlock Text="{DynamicResource '密钥按服务商和 API 地址隔离，并使用当前 Windows 用户的 DPAPI 加密。查询模型不上传输入；测试翻译只发送固定短句 Hello，可能产生少量 API 费用。不同平台的模型列表权限不同，也可以直接填写模型 ID。'}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></Border></StackPanel>
