<Window x:Class="TypeLingo.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource 'TypeLingo · 伴译'}" Width="800" Height="780" MinWidth="650" MinHeight="550" WindowStartupLocation="CenterScreen">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><TextBlock Text="{DynamicResource '伴译  /  TypeLingo'}" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource '输入在哪里，翻译就跟随到哪里。'}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" /><TextBlock Text="{DynamicResource '实时预览 · 主动替换 · 原文由你掌控'}" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0" /></StackPanel>
    <TabControl Grid.Row="1" Background="{DynamicResource CanvasBrush}" BorderThickness="0">
      <TabItem Header="{DynamicResource '基础'}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
        <TextBlock Text="{DynamicResource '界面语言'}" /><ComboBox x:Name="UiLanguageInput" DisplayMemberPath="Label" SelectedValuePath="Code" SelectionChanged="UiLanguage_SelectionChanged" />
        <TextBlock Text="{DynamicResource '翻译方向'}" /><ComboBox x:Name="PresetInput" DisplayMemberPath="Label" SelectedValuePath="Code" SelectionChanged="Preset_SelectionChanged" />
        <CheckBox x:Name="EnabledCheck" Content="{DynamicResource '开启实时翻译（托盘可随时暂停全部读取）'}" />
        <TextBlock Text="{DynamicResource '源语言'}" /><ComboBox x:Name="SourceInput" DisplayMemberPath="Label" SelectedValuePath="Code" SelectionChanged="Direction_SelectionChanged" />
        <TextBlock Text="{DynamicResource '目标语言'}" /><ComboBox x:Name="TargetInput" DisplayMemberPath="Label" SelectedValuePath="Code" SelectionChanged="Direction_SelectionChanged" />
        <TextBlock Text="{DynamicResource '翻译风格'}" /><ComboBox x:Name="ModeInput" DisplayMemberPath="Label" SelectedValuePath="Code" />
        <TextBlock Text="{DynamicResource '防抖时间（毫秒）'}" /><TextBox x:Name="DebounceInput" />
        <TextBlock Text="{DynamicResource 'API 最小请求间隔（毫秒）'}" /><TextBox x:Name="IntervalInput" />
        <TextBlock Text="{DynamicResource '最大输入字符数'}" /><TextBox x:Name="MaxInput" />
        <TextBlock Text="{DynamicResource '预览不会修改原文；只有确认替换才写入。读取不到或无法安全写入的控件会自动降级。'}" Foreground="{DynamicResource MutedBrush}" />
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="{DynamicResource 'AI'}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
        <TextBlock Text="{DynamicResource 'API 服务商'}" /><ComboBox x:Name="ProviderInput" DisplayMemberPath="Label" SelectedValuePath="Code" SelectionChanged="Provider_SelectionChanged" />
        <WrapPanel><Button Content="{DynamicResource '打开官方 API 开通 / 购买平台'}" Click="Platform_Click" /></WrapPanel><TextBlock x:Name="PlatformAddress" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,12" />
        <TextBlock Text="{DynamicResource 'API 地址（HTTPS；密钥将发送到此服务）'}" /><TextBox x:Name="BaseUrlInput" TextChanged="BaseUrl_TextChanged" />
        <TextBlock Text="{DynamicResource '模型（可从列表选择，也可手动输入模型 ID）'}" /><ComboBox x:Name="ModelInput" IsEditable="True" IsTextSearchEnabled="False" />
        <TextBlock Text="{DynamicResource 'API 密钥（每个服务商与地址单独保存，留空保留）'}" /><PasswordBox x:Name="KeyInput" />
        <TextBlock x:Name="KeyStatus" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10" />
        <TextBlock Text="{DynamicResource '请求超时（秒）'}" /><TextBox x:Name="TimeoutInput" />
        <TextBlock Text="{DynamicResource '429 / 5xx 最大重试次数'}" /><TextBox x:Name="RetriesInput" />
        <WrapPanel><Button x:Name="TestButton" Content="{DynamicResource '查询可用模型'}" Click="Test_Click" /><Button Content="{DynamicResource '删除当前服务商的密钥'}" Click="DeleteKey_Click" Background="#D1E4FA" /></WrapPanel>
        <Button x:Name="TranslateTestButton" Content="{DynamicResource '测试翻译（固定短句）'}" Click="TranslateTest_Click" HorizontalAlignment="Left" />
        <TextBlock x:Name="TestStatus" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" />
        <TextBlock Text="{DynamicResource '密钥按服务商和 API 地址隔离，并使用当前 Windows 用户的 DPAPI 加密。查询模型不上传输入；测试翻译只发送固定短句 Hello，可能产生少量 API 费用。不同平台的模型列表权限不同，也可以直接填写模型 ID。'}" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,0" />
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="{DynamicResource '缓存'}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
        <CheckBox x:Name="MemoryCheck" Content="{DynamicResource '启用内存缓存'}" /><TextBlock Text="{DynamicResource '内存最大条目数'}" /><TextBox x:Name="MemoryCapacityInput" /><TextBlock Text="{DynamicResource '内存有效期（分钟）'}" /><TextBox x:Name="MemoryTtlInput" />
        <CheckBox x:Name="DiskCheck" Content="{DynamicResource '主动启用磁盘缓存（默认关闭；可能包含私人聊天译文）'}" /><TextBlock Text="{DynamicResource '磁盘最大条目数'}" /><TextBox x:Name="DiskCapacityInput" /><TextBlock Text="{DynamicResource '磁盘有效期（天）'}" /><TextBox x:Name="DiskTtlInput" />
        <Button Content="{DynamicResource '立即清除全部缓存'}" Click="ClearCache_Click" HorizontalAlignment="Left" />
        <TextBlock Text="{DynamicResource '磁盘中的译文使用 DPAPI 加密；只保存输入哈希，不保存原文。关闭磁盘缓存不会自动删除已有内容，请使用清除按钮。日志不记录原文、译文或 Key。'}" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0" />
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="{DynamicResource '悬浮窗'}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
        <CheckBox x:Name="DarkCheck" Content="{DynamicResource '深色模式'}" /><TextBlock Text="{DynamicResource '字体大小（10–32）'}" /><TextBox x:Name="FontInput" /><TextBlock Text="{DynamicResource '不透明度（0.5–1）'}" /><TextBox x:Name="OpacityInput" /><TextBlock Text="{DynamicResource '最大宽度（240–800）'}" /><TextBox x:Name="WidthInput" /><TextBlock Text="{DynamicResource '位置偏好'}" /><ComboBox x:Name="PositionInput" DisplayMemberPath="Label" SelectedValuePath="Code" />
        <TextBlock Text="{DynamicResource '位置不足时依次尝试右、下、左、上；无法取得坐标时显示在屏幕角落。焦点离开、输入清空或暂停时自动隐藏。'}" Foreground="{DynamicResource MutedBrush}" />
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="{DynamicResource '快捷键'}"><StackPanel Margin="12">
        <TextBlock Text="{DynamicResource '准备替换 / 显示确认'}" /><TextBox x:Name="ReplaceHotkey" /><TextBlock Text="{DynamicResource '开启 / 暂停全部读取'}" /><TextBox x:Name="ToggleHotkey" /><TextBlock Text="{DynamicResource '复制当前译文'}" /><TextBox x:Name="CopyHotkey" />
        <TextBlock Text="{DynamicResource '格式：Ctrl+Alt+Enter，可使用 Shift / Win。冲突会明确提示；不会监听所有按键。复制操作会按你的要求覆盖剪贴板；软件不会自动粘贴或模拟 Enter。'}" Foreground="{DynamicResource MutedBrush}" />
      </StackPanel></TabItem>
      <TabItem Header="{DynamicResource '隐私'}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
        <TextBlock Text="{DynamicResource '先授权，再读取'}" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,10" />
        <TextBlock Text="{DynamicResource '启用后，允许应用中当前输入框的完整文本会发送给所选 AI 服务进行翻译。允许浏览器意味着其所有可访问输入框均可能被读取，包括私人页面。请只允许你信任且需要翻译的应用。'}" />
        <CheckBox x:Name="ConsentCheck" Content="{DynamicResource '我了解并同意读取允许应用的输入框，并上传给所选 API 翻译'}" />
        <TextBlock Text="{DynamicResource '允许监控的进程名（逗号分隔；空列表不读取任何应用）'}" /><TextBox x:Name="AllowedInput" ToolTip="{DynamicResource '例如 notepad, chrome, msedge；填写进程名，不填写窗口标题'}" />
        <TextBlock Text="{DynamicResource '排除的进程名（优先于允许列表）'}" /><TextBox x:Name="ExcludedInput" />
        <TextBlock Text="{DynamicResource '密码框与常见敏感标签会被排除，但无障碍接口无法识别所有敏感内容。没有按网站授权的能力，请用进程排除或托盘暂停保护敏感输入。无需管理员权限，无键盘记录、注入或驱动。'}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,16" />
        <TextBlock Text="{DynamicResource '本次会话统计'}" FontWeight="SemiBold" /><TextBlock x:Name="StatisticsText" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}" />
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock x:Name="MessageText" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8" /><DockPanel><TextBlock Text="{DynamicResource '关闭此窗口后继续在系统托盘运行'}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" /><Button Content="{DynamicResource '保存设置'}" Click="Save_Click" HorizontalAlignment="Right" Margin="10,0,0,0" /></DockPanel></StackPanel>
  </Grid>
</Window>
