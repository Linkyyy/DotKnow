<Window x:Class="TypeLingo.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:TypeLingo.App.Controls" Title="{DynamicResource 'TypeLingo · 伴译'}" Width="1180" Height="820" MinWidth="820" MinHeight="520" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="268" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Grid Grid.Column="0" Margin="14,20,12,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="10,4,4,28"><Grid.ColumnDefinitions><ColumnDefinition Width="66" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource SurfaceBrush}"><TextBlock Text="&#xE8F2;" Style="{StaticResource Glyph}" FontSize="27" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="TypeLingo · 伴译" FontWeight="SemiBold" FontSize="15" /><TextBlock Text="{DynamicResource '实时输入翻译助手'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" /></StackPanel></Grid>
      <Grid Grid.Row="1" Margin="0,0,0,24"><TextBox x:Name="SettingsSearchInput" TextChanged="Search_TextChanged" Padding="10,7,35,7" AutomationProperties.Name="{DynamicResource '查找设置'}" /><TextBlock x:Name="SearchPlaceholder" Text="{DynamicResource '查找设置'}" Foreground="{DynamicResource MutedBrush}" Margin="11,0,35,0" VerticalAlignment="Center" IsHitTestVisible="False" /><TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="13" HorizontalAlignment="Right" Margin="0,0,12,0" IsHitTestVisible="False" /></Grid>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><ListBox x:Name="NavigationList" Background="Transparent" BorderThickness="0" SelectionChanged="Navigation_SelectionChanged" ItemContainerStyle="{StaticResource NavigationItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
<ListBoxItem Tag="home" AutomationProperties.Name="{DynamicResource '主页'}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE80F;" Style="{StaticResource Glyph}" Foreground="#D06325" /><TextBlock Text="{DynamicResource '主页'}" Grid.Column="1" VerticalAlignment="Center" /></Grid></ListBoxItem>
<ListBoxItem Tag="general" AutomationProperties.Name="{DynamicResource '常规设置'}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" Foreground="#0089A8" /><TextBlock Text="{DynamicResource '常规设置'}" Grid.Column="1" VerticalAlignment="Center" /></Grid></ListBoxItem>
<ListBoxItem Tag="ai" AutomationProperties.Name="{DynamicResource 'AI 服务与模型'}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE8D4;" Style="{StaticResource Glyph}" Foreground="#0078D4" /><TextBlock Text="{DynamicResource 'AI 服务与模型'}" Grid.Column="1" VerticalAlignment="Center" /></Grid></ListBoxItem>
<ListBoxItem Tag="cache" AutomationProperties.Name="{DynamicResource '翻译缓存'}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xEDA2;" Style="{StaticResource Glyph}" Foreground="#A15B20" /><TextBlock Text="{DynamicResource '翻译缓存'}" Grid.Column="1" VerticalAlignment="Center" /></Grid></ListBoxItem>
<ListBoxItem Tag="appearance" AutomationProperties.Name="{DynamicResource '外观与悬浮窗'}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE790;" Style="{StaticResource Glyph}" Foreground="#A646C0" /><TextBlock Text="{DynamicResource '外观与悬浮窗'}" Grid.Column="1" VerticalAlignment="Center" /></Grid></ListBoxItem>
<ListBoxItem Tag="hotkeys" AutomationProperties.Name="{DynamicResource '快捷键'}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE765;" Style="{StaticResource Glyph}" Foreground="#147D79" /><TextBlock Text="{DynamicResource '快捷键'}" Grid.Column="1" VerticalAlignment="Center" /></Grid></ListBoxItem>
<ListBoxItem Tag="privacy" AutomationProperties.Name="{DynamicResource '隐私与应用'}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" Foreground="#55758E" /><TextBlock Text="{DynamicResource '隐私与应用'}" Grid.Column="1" VerticalAlignment="Center" /></Grid></ListBoxItem>
</ListBox><TextBlock x:Name="NoResultsText" Text="{DynamicResource '未找到相关设置'}" Foreground="{DynamicResource MutedBrush}" Margin="12,18" Visibility="Collapsed" /></StackPanel></ScrollViewer>
      <StackPanel Grid.Row="3" Margin="10,14,0,0"><TextBlock Text="{DynamicResource '实时预览，确认后替换'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="TypeLingo  v0.2.0" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" /></StackPanel>
    </Grid>
    <Grid Grid.Column="1" Margin="30,24,26,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,14"><StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource '设置'}" FontSize="28" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="13" Margin="17,0" /><TextBlock x:Name="PageTitleText" FontSize="28" FontWeight="SemiBold" /></StackPanel><TextBlock x:Name="PageDescriptionText" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,9,0,0" /></StackPanel>
      <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,20"><Grid>
<StackPanel x:Name="PageHome" Visibility="Collapsed"><Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,15,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="58" Height="58" CornerRadius="14" Background="{DynamicResource AccentBrush}"><TextBlock Text="&#xE8F2;" Style="{StaticResource Glyph}" FontSize="30" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource '让翻译，跟上你的表达'}" FontSize="24" FontWeight="SemiBold" /><TextBlock x:Name="HomeStateText" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" /></StackPanel></Grid></Border><UniformGrid Columns="3" Margin="0,0,-8,0"><Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,8,0"><StackPanel><TextBlock Text="{DynamicResource 'HTTP 请求'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" /><TextBlock x:Name="HomeApiCount" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel></Border><Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,8,0"><StackPanel><TextBlock Text="{DynamicResource '本地缓存命中'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" /><TextBlock x:Name="HomeCacheCount" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel></Border><Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,8,0"><StackPanel><TextBlock Text="{DynamicResource '翻译成功'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" /><TextBlock x:Name="HomeSuccessCount" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,0" /></StackPanel></Border></UniformGrid><TextBlock Text="{DynamicResource '快速访问'}" Style="{StaticResource SectionHeading}" /><controls:SettingCard Title="{DynamicResource '当前翻译方向'}" Description="{DynamicResource '选择源语言与目标语言的组合'}" Icon="&#xE8F2;"><Button Content="{DynamicResource '更改翻译方向'}" Click="OpenGeneral_Click"  /></controls:SettingCard><controls:SettingCard Title="{DynamicResource 'AI 服务与模型'}" Description="{DynamicResource '管理模型服务、账户密钥与连接'}" Icon="&#xE8D4;"><Button Content="{DynamicResource '管理模型服务'}" Click="OpenAi_Click"  /></controls:SettingCard><controls:SettingCard Title="{DynamicResource '应用访问范围'}" Description="{DynamicResource '所有应用或指定应用，随时由你决定'}" Icon="&#xE72E;"><Button Content="{DynamicResource '管理应用权限'}" Click="OpenPrivacy_Click"  /></controls:SettingCard><Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,14,0,0"><TextBlock Text="{DynamicResource '预览不会修改原文；只有确认替换才写入。读取不到或无法安全写入的控件会自动降级。'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" /></Border></StackPanel>
<StackPanel x:Name="PageGeneral" Visibility="Collapsed"><TextBlock Text="{DynamicResource '输入与翻译'}" Style="{StaticResource SectionHeading}" /><controls:SettingCard Title="{DynamicResource '实时翻译'}" Description="{DynamicResource '停止输入后自动显示译文，不会修改原文'}" Icon="&#xE8F2;"><CheckBox x:Name="EnabledCheck" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="{DynamicResource '实时翻译'}"  /></controls:SettingCard><TextBlock Text="{DynamicResource '语言与方向'}" Style="{StaticResource SectionHeading}" /><controls:SettingCard Title="{DynamicResource '界面语言'}" Description="{DynamicResource '独立于翻译语言，支持简体中文、英语和日语'}" Icon="&#xE774;"><ComboBox x:Name="UiLanguageInput" Width="260" AutomationProperties.Name="{DynamicResource '界面语言'}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectionChanged="UiLanguage_SelectionChanged" /></controls:SettingCard><controls:SettingCard Title="{DynamicResource '翻译方向'}" Description="{DynamicResource '选择源语言与目标语言的组合'}" Icon="&#xE8AB;"><ComboBox x:Name="PresetInput" Width="260" AutomationProperties.Name="{DynamicResource '翻译方向'}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectionChanged="Preset_SelectionChanged" /></controls:SettingCard><controls:SettingCard Title="{DynamicResource '源语言'}" Icon="&#xE8D2;"><ComboBox x:Name="SourceInput" Width="260" AutomationProperties.Name="{DynamicResource '源语言'}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectionChanged="Direction_SelectionChanged" /></controls:SettingCard><controls:SettingCard Title="{DynamicResource '目标语言'}" Icon="&#xE8D2;"><ComboBox x:Name="TargetInput" Width="260" AutomationProperties.Name="{DynamicResource '目标语言'}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectionChanged="Direction_SelectionChanged" /></controls:SettingCard><controls:SettingCard Title="{DynamicResource '翻译风格'}" Description="{DynamicResource '按场景选择自然、直译、商务或敬语表达'}" Icon="&#xE8F1;"><ComboBox x:Name="ModeInput" Width="260" AutomationProperties.Name="{DynamicResource '翻译风格'}" DisplayMemberPath="Label" SelectedValuePath="Code" /></controls:SettingCard><TextBlock Text="{DynamicResource '输入偏好'}" Style="{StaticResource SectionHeading}" /><controls:SettingCard Title="{DynamicResource '防抖时间（毫秒）'}" Description="{DynamicResource '输入停顿达到此时间后请求翻译'}" Icon="&#xE823;"><TextBox x:Name="DebounceInput" Width="100" AutomationProperties.Name="{DynamicResource '防抖时间（毫秒）'}"  /></controls:SettingCard><controls:SettingCard Title="{DynamicResource 'API 最小请求间隔（毫秒）'}" Description="{DynamicResource '控制连续请求频率，减少 API 消耗'}" Icon="&#xE916;"><TextBox x:Name="IntervalInput" Width="100" AutomationProperties.Name="{DynamicResource 'API 最小请求间隔（毫秒）'}"  /></controls:SettingCard><controls:SettingCard Title="{DynamicResource '最大输入字符数'}" Description="{DynamicResource '超过长度限制时跳过翻译'}" Icon="&#xE8D2;"><TextBox x:Name="MaxInput" Width="100" AutomationProperties.Name="{DynamicResource '最大输入字符数'}"  /></controls:SettingCard></StackPanel>
<StackPanel x:Name="PageAi" Visibility="Collapsed"><TextBlock Text="{DynamicResource '服务与模型'}" Style="{StaticResource SectionHeading}" /><controls:SettingCard Title="{DynamicResource 'API 服务商'}" Description="{DynamicResource '五家主流服务，模型由你选择'}" Icon="&#xE8D4;"><ComboBox x:Name="ProviderInput" Width="260" AutomationProperties.Name="{DynamicResource 'API 服务商'}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectionChanged="Provider_SelectionChanged" /></controls:SettingCard><controls:SettingCard Title="{DynamicResource '模型'}" Description="{DynamicResource '从账户列表选择，或手动输入模型 ID'}" Icon="&#xE943;"><ComboBox x:Name="ModelInput" Width="260" AutomationProperties.Name="{DynamicResource '模型'}" IsEditable="True" IsTextSearchEnabled="False" /></controls:SettingCard><controls:SettingCard Title="{DynamicResource 'API 地址'}" Description="{DynamicResource '使用 HTTPS，可连接所选平台的自定义兼容地址'}" Icon="&#xE71B;"><TextBox x:Name="BaseUrlInput" Width="280" AutomationProperties.Name="{DynamicResource 'API 地址'}" TextChanged="BaseUrl_TextChanged" /></controls:SettingCard><TextBlock Text="{DynamicResource '账户与连接'}" Style="{StaticResource SectionHeading}" /><controls:SettingCard Title="{DynamicResource 'API 密钥'}" Description="{DynamicResource '按服务商和地址分别加密保存；留空保留已有密钥'}" Icon="&#xE8D7;"><StackPanel Width="280"><PasswordBox x:Name="KeyInput" AutomationProperties.Name="{DynamicResource 'API 密钥'}" /><TextBlock x:Name="KeyStatus" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,7,0,0" /></StackPanel></controls:SettingCard><controls:SettingCard Title="{DynamicResource '官方 API 平台'}" Description="{DynamicResource '前往官方平台获取密钥、管理额度与账单'}" Icon="&#xE774;"><StackPanel Width="280"><Button Content="{DynamicResource '开通 / 购买 API'}" Click="Platform_Click"  /><TextBlock x:Name="PlatformAddress" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" /></StackPanel></controls:SettingCard><controls:SettingCard Title="{DynamicResource '连接测试'}" Description="{DynamicResource '模型查询不上传输入；翻译测试只发送 Hello'}" Icon="&#xE9D9;"><WrapPanel Width="280"><Button Content="{DynamicResource '查询可用模型'}" Click="Test_Click" x:Name="TestButton" Margin="0,3,6,3" /><Button Content="{DynamicResource '测试翻译（固定短句）'}" Click="TranslateTest_Click" x:Name="TranslateTestButton" Margin="0,3,0,3" /></WrapPanel></controls:SettingCard><TextBlock x:Name="TestStatus" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="12,8,0,4" /><controls:SettingCard Title="{DynamicResource '删除当前服务商的密钥'}" Description="{DynamicResource '仅删除当前服务商与 API 地址的本地密钥'}" Icon="&#xE74D;"><Button Content="{DynamicResource '删除密钥'}" Click="DeleteKey_Click"  /></controls:SettingCard><TextBlock Text="{DynamicResource '请求控制'}" Style="{StaticResource SectionHeading}" /><controls:SettingCard Title="{DynamicResource '请求超时（秒）'}" Icon="&#xE823;"><TextBox x:Name="TimeoutInput" Width="100" AutomationProperties.Name="{DynamicResource '请求超时（秒）'}"  /></controls:SettingCard><controls:SettingCard Title="{DynamicResource '429 / 5xx 最大重试次数'}" Description="{DynamicResource '仅对限流与临时服务错误进行有限重试'}" Icon="&#xE72C;"><TextBox x:Name="RetriesInput" Width="100" AutomationProperties.Name="{DynamicResource '429 / 5xx 最大重试次数'}"  /></controls:SettingCard><Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,14,0,0"><TextBlock Text="{DynamicResource '密钥按服务商和 API 地址隔离，并使用当前 Windows 用户的 DPAPI 加密。查询模型不上传输入；测试翻译只发送固定短句 Hello，可能产生少量 API 费用。不同平台的模型列表权限不同，也可以直接填写模型 ID。'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" /></Border></StackPanel>
<StackPanel x:Name="PageCache" Visibility="Collapsed"><TextBlock Text="{DynamicResource '内存缓存'}" Style="{StaticResource SectionHeading}" /><controls:SettingCard Title="{DynamicResource '启用内存缓存'}" Description="{DynamicResource '相同内容优先复用译文，退出后自动释放'}" Icon="&#xE950;"><CheckBox x:Name="MemoryCheck" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="{DynamicResource '启用内存缓存'}"  /></controls:SettingCard><controls:SettingCard Title="{DynamicResource '内存最大条目数'}" Icon="&#xE8B7;"><TextBox x:Name="MemoryCapacityInput" Width="100" AutomationProperties.Name="{DynamicResource '内存最大条目数'}" IsEnabled="{Binding IsChecked, ElementName=MemoryCheck}" /></controls:SettingCard><controls:SettingCard Title="{DynamicResource '内存有效期（分钟）'}" Icon="&#xE823;"><TextBox x:Name="MemoryTtlInput" Width="100" AutomationProperties.Name="{DynamicResource '内存有效期（分钟）'}" IsEnabled="{Binding IsChecked, ElementName=MemoryCheck}" /></controls:SettingCard><TextBlock Text="{DynamicResource '本地磁盘'}" Style="{StaticResource SectionHeading}" /><controls:SettingCard Title="{DynamicResource '启用磁盘缓存'}" Description="{DynamicResource '默认关闭；开启后以加密形式保留译文'}" Icon="&#xEDA2;"><CheckBox x:Name="DiskCheck" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="{DynamicResource '启用磁盘缓存'}"  /></controls:SettingCard><controls:SettingCard Title="{DynamicResource '磁盘最大条目数'}" Icon="&#xE8B7;"><TextBox x:Name="DiskCapacityInput" Width="100" AutomationProperties.Name="{DynamicResource '磁盘最大条目数'}" IsEnabled="{Binding IsChecked, ElementName=DiskCheck}" /></controls:SettingCard><controls:SettingCard Title="{DynamicResource '磁盘有效期（天）'}" Icon="&#xE823;"><TextBox x:Name="DiskTtlInput" Width="100" AutomationProperties.Name="{DynamicResource '磁盘有效期（天）'}" IsEnabled="{Binding IsChecked, ElementName=DiskCheck}" /></controls:SettingCard><controls:SettingCard Title="{DynamicResource '清除缓存'}" Description="{DynamicResource '同时清理内存和已保存的磁盘译文'}" Icon="&#xE74D;"><Button Content="{DynamicResource '立即清除全部缓存'}" Click="ClearCache_Click"  /></controls:SettingCard><TextBlock Text="{DynamicResource '本次会话统计'}" Style="{StaticResource SectionHeading}" /><Border CornerRadius="6" Padding="18" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><TextBlock x:Name="StatisticsText" FontSize="13" LineHeight="26" /></Border><Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,14,0,0"><TextBlock Text="{DynamicResource '磁盘中的译文使用 DPAPI 加密；只保存输入哈希，不保存原文。关闭磁盘缓存不会自动删除已有内容，请使用清除按钮。日志不记录原文、译文或 Key。'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" /></Border></StackPanel>
<StackPanel x:Name="PageAppearance" Visibility="Collapsed"><TextBlock Text="{DynamicResource '主题与显示'}" Style="{StaticResource SectionHeading}" /><controls:SettingCard Title="{DynamicResource '深色模式'}" Description="{DynamicResource '设置窗口与翻译悬浮窗使用一致的配色'}" Icon="&#xE790;"><CheckBox x:Name="DarkCheck" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="{DynamicResource '深色模式'}"  /></controls:SettingCard><controls:SettingCard Title="{DynamicResource '字体大小（10–32）'}" Description="{DynamicResource '调整悬浮窗中的译文字号'}" Icon="&#xE8D2;"><TextBox x:Name="FontInput" Width="100" AutomationProperties.Name="{DynamicResource '字体大小（10–32）'}"  /></controls:SettingCard><controls:SettingCard Title="{DynamicResource '不透明度（0.5–1）'}" Icon="&#xE790;"><TextBox x:Name="OpacityInput" Width="100" AutomationProperties.Name="{DynamicResource '不透明度（0.5–1）'}"  /></controls:SettingCard><controls:SettingCard Title="{DynamicResource '最大宽度（240–800）'}" Icon="&#xE740;"><TextBox x:Name="WidthInput" Width="100" AutomationProperties.Name="{DynamicResource '最大宽度（240–800）'}"  /></controls:SettingCard><TextBlock Text="{DynamicResource '悬浮窗位置'}" Style="{StaticResource SectionHeading}" /><controls:SettingCard Title="{DynamicResource '位置偏好'}" Description="{DynamicResource '优先放置在输入框旁，空间不足时自动调整'}" Icon="&#xE8A9;"><ComboBox x:Name="PositionInput" Width="260" AutomationProperties.Name="{DynamicResource '位置偏好'}" DisplayMemberPath="Label" SelectedValuePath="Code" /></controls:SettingCard><Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,14,0,0"><TextBlock Text="{DynamicResource '位置不足时依次尝试右、下、左、上；无法取得坐标时显示在屏幕角落。焦点离开、输入清空或暂停时自动隐藏。'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" /></Border></StackPanel>
<StackPanel x:Name="PageHotkeys" Visibility="Collapsed"><TextBlock Text="{DynamicResource '全局快捷键'}" Style="{StaticResource SectionHeading}" /><controls:SettingCard Title="{DynamicResource '准备替换 / 显示确认'}" Description="{DynamicResource '打开原文与译文确认，确认后才写入'}" Icon="&#xE8AC;"><TextBox x:Name="ReplaceHotkey" Width="240" AutomationProperties.Name="{DynamicResource '准备替换 / 显示确认'}"  /></controls:SettingCard><controls:SettingCard Title="{DynamicResource '开启 / 暂停全部读取'}" Icon="&#xE769;"><TextBox x:Name="ToggleHotkey" Width="240" AutomationProperties.Name="{DynamicResource '开启 / 暂停全部读取'}"  /></controls:SettingCard><controls:SettingCard Title="{DynamicResource '复制当前译文'}" Icon="&#xE8C8;"><TextBox x:Name="CopyHotkey" Width="240" AutomationProperties.Name="{DynamicResource '复制当前译文'}"  /></controls:SettingCard><Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,14,0,0"><TextBlock Text="{DynamicResource '格式：Ctrl+Alt+Enter，可使用 Shift / Win。冲突会明确提示；不会监听所有按键。复制操作会按你的要求覆盖剪贴板；软件不会自动粘贴或模拟 Enter。'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" /></Border></StackPanel>
<StackPanel x:Name="PagePrivacy" Visibility="Collapsed"><TextBlock Text="{DynamicResource '应用访问'}" Style="{StaticResource SectionHeading}" /><controls:SettingCard Title="{DynamicResource '监控所有应用'}" Description="{DynamicResource '覆盖全部可访问应用，无需逐一添加进程'}" Icon="&#xE71D;"><CheckBox x:Name="AllApplicationsCheck" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="{DynamicResource '监控所有应用'}" Checked="Scope_Changed" Unchecked="Scope_Changed" /></controls:SettingCard><controls:SettingCard x:Name="AllowedApplicationsCard" Title="{DynamicResource '允许的进程名'}" Description="{DynamicResource '关闭所有应用模式后，仅监控此列表'}" Icon="&#xE8B7;"><TextBox x:Name="AllowedInput" Width="280" AutomationProperties.Name="{DynamicResource '允许的进程名'}" Height="80" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" /></controls:SettingCard><controls:SettingCard Title="{DynamicResource '排除的进程名'}" Description="{DynamicResource '始终优先排除；用逗号或换行分隔进程名'}" Icon="&#xE711;"><TextBox x:Name="ExcludedInput" Width="280" AutomationProperties.Name="{DynamicResource '排除的进程名'}" Height="80" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" /></controls:SettingCard><TextBlock Text="{DynamicResource '授权与保护'}" Style="{StaticResource SectionHeading}" /><controls:SettingCard Title="{DynamicResource '隐私授权'}" Description="{DynamicResource '启用前明确同意将当前输入框内容发送给所选 AI'}" Icon="&#xE72E;"><CheckBox x:Name="ConsentCheck" MaxWidth="270" AutomationProperties.Name="{DynamicResource '隐私授权'}"><TextBlock Text="{DynamicResource '我同意上传输入内容用于翻译'}" FontSize="13" /></CheckBox></controls:SettingCard><controls:SettingCard Title="{DynamicResource '暂停所有读取'}" Description="{DynamicResource '立即停止监控与翻译，并隐藏悬浮窗'}" Icon="&#xE769;"><Button Content="{DynamicResource '立即暂停'}" Click="Pause_Click"  /></controls:SettingCard><Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,14,0,0"><TextBlock Text="{DynamicResource '密码框、敏感控件和排除列表始终跳过。所有应用模式只覆盖系统无障碍接口允许访问的输入框，不会提权或绕过其他程序的安全限制。'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" /></Border><Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,14,0,0"><TextBlock Text="{DynamicResource '开启全部应用监控后，可访问输入框的完整内容可能发送给所选 AI 服务。处理私人内容时可随时暂停，也可以切换回仅允许指定应用。'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" /></Border></StackPanel>
</Grid></ScrollViewer>
