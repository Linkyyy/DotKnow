<Window x:Class="TypeLingo.App.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource 'TypeLingo 翻译预览'}" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize" SizeToContent="Height" Width="380" Focusable="False">
  <Border CornerRadius="12" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20" Margin="4">
    <StackPanel>
      <DockPanel Margin="0,0,0,12"><TextBlock Text="{DynamicResource '伴译'}" Foreground="{DynamicResource AccentBrush}" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="LanguageLabel" Text="{DynamicResource '日语'}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" /></DockPanel>
      <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Focusable="False"><TextBlock x:Name="TranslationText" FontSize="16" LineHeight="25" /></ScrollViewer>
      <TextBlock x:Name="StatusText" Text="{DynamicResource '原文保持不变'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,6" />
      <WrapPanel><Button Margin="0,4,8,4" x:Name="CopyButton" Content="{DynamicResource '复制译文'}" Click="Copy_Click" Focusable="False" /><Button Margin="0,4,0,4" x:Name="ReplaceButton" Content="{DynamicResource '替换…'}" Click="Replace_Click" Focusable="False" /></WrapPanel>
      <StackPanel x:Name="Confirmation" Visibility="Collapsed" Margin="0,14,0,0">
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="10"><StackPanel><TextBlock Text="{DynamicResource '是否替换当前输入内容？'}" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource '原文'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,3" /><ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Focusable="False"><TextBlock x:Name="OriginalText" /></ScrollViewer><TextBlock Text="{DynamicResource '上方译文将写入当前输入框，不会发送消息。'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" /></StackPanel></Border>
        <WrapPanel Margin="0,8,0,0"><Button Content="{DynamicResource '取消'}" Click="Cancel_Click" Focusable="False" /><Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource '确认替换'}" Click="Confirm_Click" Focusable="False" /></WrapPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
