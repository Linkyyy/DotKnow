<Window Style="{StaticResource {x:Type Window}}" x:Class="TypeLingo.App.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:TypeLingo.App.Controls" Title="{DynamicResource 'TypeLingo 翻译预览'}" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize" SizeToContent="WidthAndHeight" MinWidth="120" MaxWidth="320" MaxHeight="360" Focusable="False">
  <Border x:Name="Bubble" CornerRadius="10" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,7" Margin="2" MouseEnter="Bubble_MouseEnter" MouseLeave="Bubble_MouseLeave">
    <StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ScrollViewer x:Name="TranslationScroll" MaxHeight="144" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" VerticalAlignment="Center"><TextBlock x:Name="TranslationText" FontSize="14" MaxWidth="220" TextWrapping="Wrap" VerticalAlignment="Center" MouseLeftButtonUp="Translation_MouseLeftButtonUp"/></ScrollViewer>
        <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,0,0,0">
          <Button x:Name="CopyButton" Style="{StaticResource IconButton}" Click="Copy_Click" ToolTip="{DynamicResource '复制译文'}" AutomationProperties.Name="{DynamicResource '复制译文'}"><controls:SymbolIcon Kind="copy" Width="14" Height="14"/></Button>
          <Button x:Name="FavoriteButton" Style="{StaticResource IconButton}" Click="Favorite_Click" ToolTip="{DynamicResource '收藏译文'}" AutomationProperties.Name="{DynamicResource '收藏译文'}"><controls:SymbolIcon Kind="favorite" Width="14" Height="14"/></Button>
          <Button x:Name="ReplaceButton" Style="{StaticResource IconButton}" Click="Replace_Click" ToolTip="{DynamicResource '替换…'}" AutomationProperties.Name="{DynamicResource '替换…'}"><controls:SymbolIcon Kind="replace" Width="14" Height="14"/></Button>
          <Button Style="{StaticResource IconButton}" Click="Dismiss_Click" ToolTip="{DynamicResource '关闭'}" AutomationProperties.Name="{DynamicResource '关闭'}"><controls:SymbolIcon Kind="close" Width="13" Height="13"/></Button>
        </StackPanel>
      </Grid>
      <TextBlock x:Name="OriginText" Visibility="Collapsed" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
      <ProgressBar x:Name="LoadingProgress" Visibility="Collapsed" IsIndeterminate="True" Height="3" Margin="0,7,0,0" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="{DynamicResource '正在翻译…'}"/>
      <StackPanel x:Name="Confirmation" Visibility="Collapsed" Margin="0,10,0,0" MaxWidth="290">
        <Border Background="{DynamicResource HoverBrush}" CornerRadius="8" Padding="10"><StackPanel><TextBlock Text="{DynamicResource '是否替换当前选区或所在行？'}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource '原文'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,3"/><ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto" Focusable="False"><TextBlock x:Name="OriginalText" TextWrapping="Wrap"/></ScrollViewer><TextBlock Text="{DynamicResource '上方译文只替换选区或当前行，不会发送消息。'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel></Border>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="{DynamicResource '取消'}" Click="Cancel_Click" Focusable="False" Margin="0,0,8,0"/><Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource '确认替换'}" Click="Confirm_Click" Focusable="False"/></StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
