<Window x:Class="DotKnow.App.AssistantWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:DotKnow.App.Controls"
        Title="{DynamicResource '点知 · 划选即问'}" Icon="pack://application:,,,/DotKnow;component/Assets/dotknow.ico" Width="460" Height="360" MinWidth="320" MinHeight="260" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Background="{DynamicResource CanvasBrush}" PreviewKeyDown="Window_PreviewKeyDown">
  <Border Background="{DynamicResource CanvasBrush}" Padding="18,14"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <controls:BrandMark Width="21" Height="21" Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0"/>
      <TextBlock x:Name="TaskHeading" Grid.Column="1" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <Button Grid.Column="2" Style="{StaticResource OverlayIconButton}" Click="Dismiss_Click" AutomationProperties.Name="{DynamicResource '关闭'}"><controls:SymbolIcon Kind="close" Width="14" Height="14"/></Button>
    </Grid>
    <Expander x:Name="SourceExpander" Grid.Row="1" Margin="0,0,0,12" HorizontalContentAlignment="Stretch">
      <Expander.Header><TextBlock x:Name="SelectionPreview" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource MutedBrush}" MaxWidth="350"/></Expander.Header>
      <TextBox x:Name="SelectionText" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MaxHeight="80" Padding="8" Margin="0,7,0,0" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource '选中的内容'}"/>
    </Expander>
    <StackPanel x:Name="EditorPanel" Grid.Row="2" Margin="0,0,0,12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ComboBox x:Name="TaskInput" HorizontalAlignment="Left" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Task_SelectionChanged" AutomationProperties.Name="{DynamicResource '选择任务'}"/>
        <Button x:Name="SubmitButton" Grid.Column="1" Content="{DynamicResource '开始查询'}" Style="{StaticResource PrimaryButton}" Click="Submit_Click" Margin="10,0,0,0" Padding="14,8"/>
      </Grid>
      <TextBlock x:Name="TaskDescription" Visibility="Collapsed"/>
      <Button x:Name="QuestionToggleButton" Content="{DynamicResource '补充问题'}" Click="QuestionToggle_Click" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0,6" Margin="0,4,0,0"/>
      <StackPanel x:Name="QuestionPanel" Visibility="Collapsed" Margin="0,8,0,0">
        <TextBox x:Name="QuestionInput" Height="56" MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource '输入你的问题'}" ToolTip="{DynamicResource '例如：用一个生活中的例子解释。Ctrl+Enter 发送'}"/>
      </StackPanel>
    </StackPanel>
    <Grid Grid.Row="3" Margin="0,0,0,12" MinHeight="48">
      <TextBlock x:Name="EmptyText" Text="{DynamicResource '选一个预设直接查询，或写下你的问题。'}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
      <TextBox x:Name="AnswerText" IsReadOnly="True" Visibility="Collapsed" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="{DynamicResource '查询结果'}"/>
    </Grid>
    <StackPanel Grid.Row="4">
      <ProgressBar x:Name="QueryProgress" IsIndeterminate="True" Height="3" Visibility="Collapsed" Margin="0,0,0,8"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="QueryStatus" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{DynamicResource 'AI 回答可能有误；百科等任务需要在线模型，不提供实时联网检索。'}"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="FollowUpButton" Content="{DynamicResource '追问'}" Visibility="Collapsed" Click="FollowUp_Click" Padding="9,6" Margin="0,0,6,0"/>
          <Button x:Name="CopyAnswerButton" Content="{DynamicResource '复制结果'}" IsEnabled="False" Click="Copy_Click" Padding="9,6"/>
          <Button x:Name="SaveAnswerButton" Content="{DynamicResource '收藏'}" IsEnabled="False" Click="Favorite_Click" Padding="9,6" Margin="6,0,0,0"/>
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid></Border>
</Window>
