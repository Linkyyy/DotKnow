<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:DotKnow.App.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="DotKnow.App.SettingsWindow" Style="{StaticResource {x:Type Window}}" Title="{DynamicResource '点解 · DotKnow'}" Width="1040" Height="820" MinWidth="760" MinHeight="520" WindowStyle="None" ResizeMode="CanResize" Icon="pack://application:,,,/DotKnow;component/Assets/dotknow.ico" WindowStartupLocation="CenterScreen">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="66" CornerRadius="16" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Border Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="66" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="23,0,15,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <controls:BrandMark Width="32" Height="32" Margin="0,0,10,0" />
            <TextBlock Text="DotKnow" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Width="1" Height="15" Background="{DynamicResource BorderBrush}" Margin="14,0" />
            <TextBlock Text="{DynamicResource '点解'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Content="{DynamicResource '打开配置文件'}" Click="OpenConfig_Click" FontSize="11" Padding="12,6" MinHeight="30" Margin="0,0,12,0" />
            <Button Click="Minimize_Click" Style="{StaticResource IconButton}" AutomationProperties.Name="{DynamicResource '最小化'}" ToolTip="{DynamicResource '最小化'}" Margin="0,0,5,0">
              <TextBlock Text="−" FontSize="18" />
            </Button>
            <Button Click="CloseSettings_Click" Style="{StaticResource IconButton}" ToolTip="{DynamicResource '关闭'}" AutomationProperties.Name="{DynamicResource '关闭'}">
              <controls:SymbolIcon Kind="close" Width="15" Height="15" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="SidebarColumn" Width="216" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SidebarBrush}" CornerRadius="0,0,0,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
          <Grid Margin="14,19,14,17">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,17">
              <TextBox x:Name="SettingsSearchInput" TextChanged="Search_TextChanged" GotKeyboardFocus="Search_FocusChanged" LostKeyboardFocus="Search_FocusChanged" TextAlignment="Left" HorizontalContentAlignment="Left" Padding="11,9,32,9" FontSize="11" AutomationProperties.Name="{DynamicResource '查找设置'}" />
              <TextBlock x:Name="SearchPlaceholder" Text="{DynamicResource '查找设置'}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="12,0,31,0" VerticalAlignment="Center" IsHitTestVisible="False" />
              <controls:SymbolIcon Kind="search" Width="14" Height="14" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" Margin="0,0,11,0" IsHitTestVisible="False" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="SidebarNavigationHost">
                <TextBlock Text="{DynamicResource '你的工作台'}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="14,0,0,9" />
                <ListBox x:Name="NavigationList" Background="Transparent" BorderThickness="0" SelectionChanged="Navigation_SelectionChanged" ItemContainerStyle="{StaticResource NavigationItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                  <ListBoxItem Tag="home" AutomationProperties.Name="{DynamicResource '主页'}">
                    <StackPanel Orientation="Horizontal">
                      <controls:SymbolIcon Kind="home" Margin="0,0,10,0" />
                      <TextBlock Text="{DynamicResource '主页'}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </ListBoxItem>
                  <ListBoxItem Tag="prompts" AutomationProperties.Name="{DynamicResource '任务与提示词'}">
                    <StackPanel Orientation="Horizontal"><controls:SymbolIcon Kind="model" Margin="0,0,10,0"/><TextBlock Text="{DynamicResource '任务与提示词'}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel>
                  </ListBoxItem>
                  <ListBoxItem Tag="general" AutomationProperties.Name="{DynamicResource '常规设置'}">
                    <StackPanel Orientation="Horizontal">
                      <controls:SymbolIcon Kind="settings" Margin="0,0,10,0" />
                      <TextBlock Text="{DynamicResource '常规设置'}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </ListBoxItem>
                  <ListBoxItem Tag="vocabulary" AutomationProperties.Name="{DynamicResource '离线题库'}">
                    <StackPanel Orientation="Horizontal">
                      <controls:SymbolIcon Kind="cache" Margin="0,0,10,0" />
                      <TextBlock Text="{DynamicResource '离线题库'}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </ListBoxItem>
                  <ListBoxItem Tag="ai" AutomationProperties.Name="{DynamicResource 'AI 服务与模型'}">
                    <StackPanel Orientation="Horizontal">
                      <controls:SymbolIcon Kind="model" Margin="0,0,10,0" />
                      <TextBlock Text="{DynamicResource 'AI 服务与模型'}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </ListBoxItem>
                  <ListBoxItem Tag="appearance" AutomationProperties.Name="{DynamicResource '外观与悬浮窗'}">
                    <StackPanel Orientation="Horizontal">
                      <controls:SymbolIcon Kind="overlay" Margin="0,0,10,0" />
                      <TextBlock Text="{DynamicResource '外观与悬浮窗'}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </ListBoxItem>
                  <ListBoxItem Tag="hotkeys" AutomationProperties.Name="{DynamicResource '快捷键'}">
                    <StackPanel Orientation="Horizontal">
                      <controls:SymbolIcon Kind="keyboard" Margin="0,0,10,0" />
                      <TextBlock Text="{DynamicResource '快捷键'}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </ListBoxItem>
                  <ListBoxItem Tag="cache" AutomationProperties.Name="{DynamicResource '结果缓存'}">
                    <StackPanel Orientation="Horizontal">
                      <controls:SymbolIcon Kind="cache" Margin="0,0,10,0" />
                      <TextBlock Text="{DynamicResource '结果缓存'}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </ListBoxItem>
                  <ListBoxItem Tag="privacy" AutomationProperties.Name="{DynamicResource '隐私与应用'}">
                    <StackPanel Orientation="Horizontal">
                      <controls:SymbolIcon Kind="shield" Margin="0,0,10,0" />
                      <TextBlock Text="{DynamicResource '隐私与应用'}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </ListBoxItem>
                  <ListBoxItem Tag="favorites" AutomationProperties.Name="{DynamicResource '本地收藏与复习'}">
                    <StackPanel Orientation="Horizontal">
                      <controls:SymbolIcon Kind="favorite" Margin="0,0,10,0" />
                      <TextBlock Text="{DynamicResource '本地收藏与复习'}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </ListBoxItem>
                </ListBox>
                <TextBlock x:Name="NoResultsText" Text="{DynamicResource '未找到相关设置'}" Foreground="{DynamicResource MutedBrush}" Margin="12,18" Visibility="Collapsed" />
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="10" Padding="13" Margin="0,16,0,0">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0" />
                  <TextBlock x:Name="SidebarStateText" FontSize="10" />
                </StackPanel>
                <TextBlock x:Name="VersionLabel" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="12,6,0,0" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="28,24,18,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <StackPanel x:Name="PageHeader" Margin="0,0,10,21">
            <TextBlock Text="MAKE IT YOURS" Style="{StaticResource Eyebrow}" />
            <TextBlock x:Name="PageTitleText" FontSize="25" FontWeight="SemiBold" />
            <TextBlock x:Name="PageDescriptionText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
          </StackPanel>
          <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,24">
            <Grid x:Name="PagesHost">
              <StackPanel x:Name="PageHome" Visibility="Collapsed">
                <Border Background="{DynamicResource HeroBrush}" CornerRadius="16" Padding="26" Margin="0,0,0,20" x:Name="HomeHeroBorder">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="DOTKNOW / SELECT. ASK. UNDERSTAND." FontSize="9" Foreground="{DynamicResource HeroMutedBrush}" Margin="0,0,0,20" x:Name="HomeHeroEyebrow" />
                      <WrapPanel x:Name="HomeHeadlinePanel" Orientation="Vertical">
                        <TextBlock Text="{DynamicResource '哪里不会，'}" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource HeroTextBrush}" x:Name="HomeHeadingFirst" />
                        <TextBlock Text="{DynamicResource '点哪里。'}" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource HeroHighlightBrush}" Margin="0,0,0,15" x:Name="HomeHeadingSecond" />
                      </WrapPanel>
                      <TextBlock x:Name="HomeStateText" FontSize="11" Foreground="{DynamicResource HeroMutedBrush}" LineHeight="19" />
                      <Button x:Name="HomeStartButton" Content="{DynamicResource '开始使用'}" Click="HomeStart_Click" Style="{StaticResource HighlightButton}" HorizontalAlignment="Left" Margin="0,20,0,0" Padding="18,9" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,34,0,0" x:Name="HomeLogoPanel">
                      <Image x:Name="HomeBrandImage" Source="pack://application:,,,/DotKnow;component/Assets/dotknow.png" Width="58" Height="58" AutomationProperties.Name="DotKnow Logo" />
                      <TextBlock Text="SELECT / ASK" FontSize="10" Foreground="{DynamicResource HeroMutedBrush}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Grid Margin="0,0,0,11">
                  <TextBlock Text="{DynamicResource '本次运行'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                  <TextBlock Text="{DynamicResource '每一次理解，都算数。'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" />
                </Grid>
                <UniformGrid Columns="3" Margin="0,0,-10,0">
                  <Border Style="{StaticResource CardFrame}" Padding="18" Margin="0,0,10,0">
                    <StackPanel>
                      <TextBlock Text="{DynamicResource 'HTTP 请求'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                      <TextBlock x:Name="HomeApiCount" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource CardFrame}" Padding="18" Margin="0,0,10,0">
                    <StackPanel>
                      <TextBlock Text="{DynamicResource '本地命中'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                      <TextBlock x:Name="HomeCacheCount" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource CardFrame}" Padding="18" Margin="0,0,10,0">
                    <StackPanel>
                      <TextBlock Text="{DynamicResource '完成查询'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                      <TextBlock x:Name="HomeSuccessCount" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,0" />
                    </StackPanel>
                  </Border>
                </UniformGrid>
                <TextBlock Text="{DynamicResource '快速访问'}" Style="{StaticResource SectionHeading}" />
                <UniformGrid Columns="2" Margin="0,0,-10,-10" x:Name="HomeQuickActions">
                  <Button Style="{StaticResource QuickAction}" Tag="prompts" Click="Navigate_Click" Margin="0,0,10,10" AutomationProperties.Name="{DynamicResource '任务与提示词'}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                      </Grid.ColumnDefinitions>
                      <controls:SymbolIcon Kind="settings" Width="19" Height="19" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Margin="10,0,5,0">
                        <TextBlock Text="{DynamicResource '任务与提示词'}" FontSize="13" />
                        <TextBlock Text="{DynamicResource '百科、翻译与自定义提问'}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="↗" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                  <Button Style="{StaticResource QuickAction}" Tag="vocabulary" Click="Navigate_Click" Margin="0,0,10,10" AutomationProperties.Name="{DynamicResource '离线题库'}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                      </Grid.ColumnDefinitions>
                      <controls:SymbolIcon Kind="cache" Width="19" Height="19" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Margin="10,0,5,0">
                        <TextBlock Text="{DynamicResource '离线题库'}" FontSize="13" />
                        <TextBlock Text="{DynamicResource '常用的，留在本地。'}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="↗" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                  <Button Style="{StaticResource QuickAction}" Tag="favorites" Click="Navigate_Click" Margin="0,0,10,10" AutomationProperties.Name="{DynamicResource '收藏与复习'}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                      </Grid.ColumnDefinitions>
                      <controls:SymbolIcon Kind="favorite" Width="19" Height="19" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Margin="10,0,5,0">
                        <TextBlock Text="{DynamicResource '收藏与复习'}" FontSize="13" />
                        <TextBlock Text="{DynamicResource '把新知识，变成自己的。'}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="↗" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                  <Button Style="{StaticResource QuickAction}" Tag="appearance" Click="Navigate_Click" Margin="0,0,10,10" AutomationProperties.Name="{DynamicResource '外观主题'}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                      </Grid.ColumnDefinitions>
                      <controls:SymbolIcon Kind="overlay" Width="19" Height="19" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Margin="10,0,5,0">
                        <TextBlock Text="{DynamicResource '外观主题'}" FontSize="13" />
                        <TextBlock Text="{DynamicResource '让点解更像你的桌面。'}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="↗" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </UniformGrid>
                <Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="10" Padding="16" Margin="0,22,0,0" x:Name="HomeNoticeBorder">
                  <TextBlock Text="{DynamicResource '默认划选即问。选预设，或写下自己的问题。翻译模式保留离线词库。'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" LineHeight="19" />
                </Border>
              </StackPanel>
              <StackPanel x:Name="PagePrompts" Visibility="Collapsed">
                <Border Style="{StaticResource CardFrame}" Background="{DynamicResource AccentSurfaceBrush}" Margin="0,0,0,18"><StackPanel><TextBlock Text="{DynamicResource '你的桌面点读机'}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource '划选不懂的内容，选择预设或输入问题。翻译依然在这里，离线词库只用于翻译模式。'}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
                <controls:SettingCard Title="{DynamicResource '默认任务'}"><ComboBox x:Name="AssistantTaskInput" DisplayMemberPath="Label" SelectedValuePath="Code" AutomationProperties.Name="{DynamicResource '默认任务'}"/></controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '划选之后'}"><ComboBox x:Name="SelectionActionInput" DisplayMemberPath="Label" SelectedValuePath="Code" AutomationProperties.Name="{DynamicResource '划选之后'}"/></controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '回答语言'}" Description="{DynamicResource '百科等任务的回答语言；翻译方向在常规设置中单独选择。'}"><ComboBox x:Name="AnswerLanguageInput" DisplayMemberPath="Label" SelectedValuePath="Code" AutomationProperties.Name="{DynamicResource '回答语言'}"/></controls:SettingCard>
                <TextBlock Text="{DynamicResource '预设提示词'}" Style="{StaticResource SectionHeading}"/>
                <Border Style="{StaticResource CardFrame}"><StackPanel>
                  <ListBox x:Name="PromptList" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="Prompt_SelectionChanged" MaxHeight="180" MinHeight="100" AutomationProperties.Name="{DynamicResource '预设提示词'}"/>
                  <Button x:Name="NewPromptButton" Content="{DynamicResource '新建提示词'}" Click="NewPrompt_Click" HorizontalAlignment="Left" Margin="0,12,0,15"/>
                  <TextBlock Text="{DynamicResource '名称'}" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="PromptNameInput" MaxLength="40" AutomationProperties.Name="{DynamicResource '提示词名称'}"/>
                  <TextBlock Text="{DynamicResource '任务指令'}" FontSize="11" Margin="0,12,0,6"/><TextBox x:Name="PromptBodyInput" Height="160" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="6000" AutomationProperties.Name="{DynamicResource '任务指令'}"/>
                  <TextBlock Text="{DynamicResource '只写希望 AI 如何回答；选中的文本会单独提供，无需填写占位符。内置预设只读，可新建自己的版本。'}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,12"/>
                  <StackPanel Orientation="Horizontal"><Button x:Name="StorePromptButton" Content="{DynamicResource '保存此预设'}" Click="StorePrompt_Click"/><Button x:Name="DeletePromptButton" Content="{DynamicResource '删除此预设'}" Click="DeletePrompt_Click" Margin="10,0,0,0"/></StackPanel>
                </StackPanel></Border>
                <TextBlock Text="{DynamicResource '百科等任务需要配置在线 API。离线优先、仅离线和自动积累只影响纯翻译；补充问题将作为 AI 任务处理。'}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,15,0,0"/>
              </StackPanel>
              <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
                <controls:SettingCard Title="{DynamicResource '划选助手'}" Description="{DynamicResource '按所选出现方式查询，不会自动修改原文'}">
                  <CheckBox x:Name="EnabledCheck" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="{DynamicResource '划选助手'}" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '界面语言'}" Description="{DynamicResource '独立于翻译语言，支持简体中文、英语和日语'}">
                  <ComboBox x:Name="UiLanguageInput" AutomationProperties.Name="{DynamicResource '界面语言'}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectionChanged="UiLanguage_SelectionChanged" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '界面外观'}" Description="{DynamicResource '配色、明暗与悬浮窗样式'}">
                  <Button Content="{DynamicResource '自定义外观'}" Tag="appearance" Click="Navigate_Click" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '悬浮窗出现方式'}" Description="{DynamicResource '默认鼠标拖选并松开后翻译，支持网页、文档和应用阅读文本'}">
                  <ComboBox x:Name="TriggerInput" DisplayMemberPath="Label" SelectedValuePath="Code" AutomationProperties.Name="{DynamicResource '悬浮窗出现方式'}" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '微信划选兼容'}" Description="{DynamicResource '微信无法直接读取选区时，划选后临时复制所选文字并恢复剪贴板。'}">
                  <CheckBox x:Name="WeChatFallbackCheck" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="{DynamicResource '微信划选兼容'}"/>
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '自动查询窗口显示时机'}" Description="{DynamicResource '选择翻译中显示进度，或翻译完成后再显示窗口'}">
                  <ComboBox x:Name="PopupDisplayInput" DisplayMemberPath="Label" SelectedValuePath="Code" AutomationProperties.Name="{DynamicResource '自动查询窗口显示时机'}" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '翻译方向'}" Description="{DynamicResource '选择源语言与目标语言的组合'}">
                  <ComboBox x:Name="PresetInput" AutomationProperties.Name="{DynamicResource '翻译方向'}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectionChanged="Preset_SelectionChanged" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '源语言'}">
                  <ComboBox x:Name="SourceInput" AutomationProperties.Name="{DynamicResource '源语言'}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectionChanged="Direction_SelectionChanged" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '目标语言'}">
                  <ComboBox x:Name="TargetInput" AutomationProperties.Name="{DynamicResource '目标语言'}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectionChanged="Direction_SelectionChanged" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '翻译风格'}" Description="{DynamicResource '按场景选择自然、直译、商务或敬语表达'}">
                  <ComboBox x:Name="ModeInput" AutomationProperties.Name="{DynamicResource '翻译风格'}" DisplayMemberPath="Label" SelectedValuePath="Code" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '防抖时间（毫秒）'}" Description="{DynamicResource '选区稳定或输入停顿达到此时间后执行自动任务'}">
                  <TextBox x:Name="DebounceInput" Width="72" AutomationProperties.Name="{DynamicResource '防抖时间（毫秒）'}" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource 'API 最小请求间隔（毫秒）'}" Description="{DynamicResource '控制连续请求频率，减少 API 消耗'}">
                  <TextBox x:Name="IntervalInput" Width="72" AutomationProperties.Name="{DynamicResource 'API 最小请求间隔（毫秒）'}" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '最大输入字符数'}" Description="{DynamicResource '超过长度限制时跳过读取'}">
                  <TextBox x:Name="MaxInput" Width="72" AutomationProperties.Name="{DynamicResource '最大输入字符数'}" />
                </controls:SettingCard>
              </StackPanel>
              <StackPanel x:Name="PageVocabulary" Visibility="Collapsed">
                <Border Style="{StaticResource CardFrame}" Background="{DynamicResource AccentSurfaceBrush}" Margin="0,0,0,18">
                  <StackPanel>
                    <TextBlock Text="OFFLINE FIRST" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="{DynamicResource '常用的，留在本地。'}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource '先查本地题库，未命中再在线翻译；内置 32159 条中英日六向记录。'}" Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,0" FontSize="11" />
                  </StackPanel>
                </Border>
                <controls:SettingCard Title="{DynamicResource '优先使用离线题库'}" Description="{DynamicResource '默认开启；命中时无需 API Key，也不调用在线服务'}">
                  <CheckBox x:Name="PreferOfflineCheck" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="{DynamicResource '优先使用离线题库'}" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '未命中时允许在线翻译'}" Description="{DynamicResource '关闭后仅查询题库；未命中会提示，不发送文本'}">
                  <CheckBox x:Name="OnlineFallbackCheck" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="{DynamicResource '未命中时允许在线翻译'}" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '自动积累在线译文'}" Description="{DynamicResource '将在线结果和以后命中的旧缓存连同原文加密保存；不覆盖人工条目'}">
                  <CheckBox x:Name="AutoLearnCheck" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="{DynamicResource '自动积累在线译文'}" />
                </controls:SettingCard>
                <TextBlock x:Name="VocabularyCountText" Text="{DynamicResource '正在加载离线题库…'}" Margin="0,16,0,10" />
                <TextBlock Text="{DynamicResource '按原文、语言方向和风格精确匹配；自动源语言有歧义时不猜测。'}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12" />
                <StackPanel x:Name="VocabularyManagePanel">
                  <WrapPanel Margin="0,0,0,10">
                    <Button x:Name="ImportVocabularyButton" Content="{DynamicResource '导入题库'}" Click="ImportVocabulary_Click" Margin="0,0,8,6" />
                    <Button Content="{DynamicResource '导出题库'}" Click="ExportVocabulary_Click" Margin="0,0,8,6" />
                    <Button x:Name="RefreshVocabularyButton" Content="{DynamicResource '刷新题库'}" Click="RefreshVocabulary_Click" Margin="0,0,8,6" />
                    <Button Content="{DynamicResource '恢复内置词库'}" Click="RestoreVocabulary_Click" Margin="0,0,8,6" />
                    <Button Content="{DynamicResource '清空题库'}" Click="ClearVocabulary_Click" Margin="0,0,0,6" />
                  </WrapPanel>
                  <TextBlock Text="{DynamicResource '搜索原文或译文'}" FontSize="12" Margin="0,8,0,8" />
                  <TextBox x:Name="VocabularySearchInput" TextChanged="VocabularySearch_Changed" AutomationProperties.Name="{DynamicResource '搜索原文或译文'}" ToolTip="{DynamicResource '搜索原文或译文'}" Margin="0,0,0,10" />
                  <TextBlock Text="{DynamicResource '列表最多显示 100 条；输入关键词缩小范围，选中后可修改译文。'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10" />
                  <ListBox x:Name="VocabularyList" MaxHeight="280" SelectionChanged="Vocabulary_SelectionChanged" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{DynamicResource '离线题库'}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14" Background="{DynamicResource CardBrush}" CornerRadius="10" Margin="0,0,0,6">
                          <StackPanel>
                            <TextBlock Text="{Binding Original}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Question}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                          <TextBlock Text="{Binding Translation}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Text="{DynamicResource '修改所选条目的译文'}" Margin="0,14,0,8" />
                  <TextBox x:Name="VocabularyEditTranslation" Height="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="40000" AutomationProperties.Name="{DynamicResource '修改所选条目的译文'}" />
                  <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="VocabularyEditButton" Content="{DynamicResource '保存译文'}" Click="EditVocabulary_Click" IsEnabled="False" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" />
                    <Button x:Name="VocabularyDeleteButton" Content="{DynamicResource '删除题库条目'}" Click="DeleteVocabulary_Click" IsEnabled="False" />
                  </WrapPanel>
                </StackPanel>
                <TextBlock Text="{DynamicResource '个人条目在本机加密保存，没有有效期，与临时缓存分开；导出文件包含明文，请妥善保管。'}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,16,0,0" />
                <TextBlock Text="{DynamicResource '内置词库由用户提供，原始三语词条 6426 组；署名 DotKnow vocabulary authors，许可 CC BY 4.0。说明随安装包提供。'}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,0" />
              </StackPanel>
              <StackPanel x:Name="PageAi" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource '服务与模型'}" Style="{StaticResource SectionHeading}" />
                <controls:SettingCard Title="{DynamicResource 'API 服务商'}" Description="{DynamicResource '五家主流服务，模型由你选择'}">
                  <ComboBox x:Name="ProviderInput" AutomationProperties.Name="{DynamicResource 'API 服务商'}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectionChanged="Provider_SelectionChanged" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '模型'}" Description="{DynamicResource '从账户列表选择，或手动输入模型 ID'}">
                  <ComboBox x:Name="ModelInput" Width="180" AutomationProperties.Name="{DynamicResource '模型'}" IsEditable="True" IsTextSearchEnabled="False" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource 'API 地址'}" Description="{DynamicResource '使用 HTTPS，可连接所选平台的自定义兼容地址'}">
                  <TextBox x:Name="BaseUrlInput" Width="240" AutomationProperties.Name="{DynamicResource 'API 地址'}" TextChanged="BaseUrl_TextChanged" />
                </controls:SettingCard>
                <TextBlock Text="{DynamicResource '账户与连接'}" Style="{StaticResource SectionHeading}" />
                <controls:SettingCard Title="{DynamicResource 'API 密钥'}" Description="{DynamicResource '按服务商和地址分别加密保存；留空保留已有密钥'}">
                  <StackPanel Width="240">
                    <PasswordBox x:Name="KeyInput" AutomationProperties.Name="{DynamicResource 'API 密钥'}" />
                    <TextBlock x:Name="KeyStatus" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,7,0,0" />
                  </StackPanel>
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '官方 API 平台'}" Description="{DynamicResource '前往官方平台获取密钥、管理额度与账单'}">
                  <StackPanel Width="240">
                    <Button Content="{DynamicResource '开通 / 购买 API'}" Click="Platform_Click" />
                    <TextBlock x:Name="PlatformAddress" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" />
                  </StackPanel>
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '连接测试'}" Description="{DynamicResource '模型查询不上传输入；翻译测试只发送 Hello'}">
                  <WrapPanel Width="240">
                    <Button Content="{DynamicResource '查询可用模型'}" Click="Test_Click" x:Name="TestButton" Margin="0,3,6,3" />
                    <Button Content="{DynamicResource '测试翻译（固定短句）'}" Click="TranslateTest_Click" x:Name="TranslateTestButton" Margin="0,3,0,3" />
                  </WrapPanel>
                </controls:SettingCard>
                <TextBlock x:Name="TestStatus" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="12,8,0,4" />
                <controls:SettingCard Title="{DynamicResource '删除当前服务商的密钥'}" Description="{DynamicResource '仅删除当前服务商与 API 地址的本地密钥'}">
                  <Button Content="{DynamicResource '删除密钥'}" Click="DeleteKey_Click" />
                </controls:SettingCard>
                <TextBlock Text="{DynamicResource '请求控制'}" Style="{StaticResource SectionHeading}" />
                <controls:SettingCard Title="{DynamicResource '请求超时（秒）'}">
                  <TextBox x:Name="TimeoutInput" Width="72" AutomationProperties.Name="{DynamicResource '请求超时（秒）'}" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '429 / 5xx 最大重试次数'}" Description="{DynamicResource '仅对限流与临时服务错误进行有限重试'}">
                  <TextBox x:Name="RetriesInput" Width="72" AutomationProperties.Name="{DynamicResource '429 / 5xx 最大重试次数'}" />
                </controls:SettingCard>
                <Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,14,0,0">
                  <TextBlock Text="{DynamicResource '密钥按服务商和 API 地址隔离，并使用当前 Windows 用户的 DPAPI 加密。查询模型不上传输入；测试翻译只发送固定短句 Hello，可能产生少量 API 费用。不同平台的模型列表权限不同，也可以直接填写模型 ID。'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                </Border>
              </StackPanel>
              <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Text="{DynamicResource '选择你的配色'}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                  <TextBlock Text="{DynamicResource '五套配色，每一套都支持浅色、深色与跟随系统。'}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,16" />
                  <UniformGrid x:Name="PaletteGrid" Columns="3" Margin="0,0,-8,0">
                    <RadioButton x:Name="PaperPaletteRadio" GroupName="palette" Tag="paper" Style="{StaticResource PaletteTile}" Checked="Theme_Changed" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource '浅纸'}">
                      <StackPanel>
                        <Border Height="47" Background="#F7F8F2" CornerRadius="6" Padding="7" BorderBrush="#253329" BorderThickness="1">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#253329" CornerRadius="3" Margin="0,0,5,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <Border Height="5" Background="#253329" CornerRadius="2" />
                              <Border Height="8" Background="#D9FA82" CornerRadius="3" Margin="0,6,6,0" />
                            </StackPanel>
                          </Grid>
                        </Border>
                        <TextBlock Text="{DynamicResource '浅纸'}" FontSize="12" Margin="0,10,0,0" />
                        <TextBlock Text="{DynamicResource '官网同款'}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="WhitePaletteRadio" GroupName="palette" Tag="white" Style="{StaticResource PaletteTile}" Checked="Theme_Changed" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource '纯白'}">
                      <StackPanel>
                        <Border Height="47" Background="#FFFFFF" CornerRadius="6" Padding="7" BorderBrush="#30343B" BorderThickness="1">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#30343B" CornerRadius="3" Margin="0,0,5,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <Border Height="5" Background="#30343B" CornerRadius="2" />
                              <Border Height="8" Background="#E5E7EB" CornerRadius="3" Margin="0,6,6,0" />
                            </StackPanel>
                          </Grid>
                        </Border>
                        <TextBlock Text="{DynamicResource '纯白'}" FontSize="12" Margin="0,10,0,0" />
                        <TextBlock Text="{DynamicResource '纯白与中性灰'}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ForestPaletteRadio" GroupName="palette" Tag="forest" Style="{StaticResource PaletteTile}" Checked="Theme_Changed" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource '深林'}">
                      <StackPanel>
                        <Border Height="47" Background="#F0F5EE" CornerRadius="6" Padding="7" BorderBrush="#294B3A" BorderThickness="1">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#294B3A" CornerRadius="3" Margin="0,0,5,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <Border Height="5" Background="#294B3A" CornerRadius="2" />
                              <Border Height="8" Background="#C9ED9D" CornerRadius="3" Margin="0,6,6,0" />
                            </StackPanel>
                          </Grid>
                        </Border>
                        <TextBlock Text="{DynamicResource '深林'}" FontSize="12" Margin="0,10,0,0" />
                        <TextBlock Text="{DynamicResource '自然草木'}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="OceanPaletteRadio" GroupName="palette" Tag="ocean" Style="{StaticResource PaletteTile}" Checked="Theme_Changed" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource '雾蓝'}">
                      <StackPanel>
                        <Border Height="47" Background="#F2F6F9" CornerRadius="6" Padding="7" BorderBrush="#294D67" BorderThickness="1">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#294D67" CornerRadius="3" Margin="0,0,5,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <Border Height="5" Background="#294D67" CornerRadius="2" />
                              <Border Height="8" Background="#C5E7F4" CornerRadius="3" Margin="0,6,6,0" />
                            </StackPanel>
                          </Grid>
                        </Border>
                        <TextBlock Text="{DynamicResource '雾蓝'}" FontSize="12" Margin="0,10,0,0" />
                        <TextBlock Text="{DynamicResource '清透蓝灰'}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="LavenderPaletteRadio" GroupName="palette" Tag="lavender" Style="{StaticResource PaletteTile}" Checked="Theme_Changed" Margin="0,0,8,8" AutomationProperties.Name="{DynamicResource '暮紫'}">
                      <StackPanel>
                        <Border Height="47" Background="#F7F4FA" CornerRadius="6" Padding="7" BorderBrush="#514166" BorderThickness="1">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Border Background="#514166" CornerRadius="3" Margin="0,0,5,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <Border Height="5" Background="#514166" CornerRadius="2" />
                              <Border Height="8" Background="#E3D4FB" CornerRadius="3" Margin="0,6,6,0" />
                            </StackPanel>
                          </Grid>
                        </Border>
                        <TextBlock Text="{DynamicResource '暮紫'}" FontSize="12" Margin="0,10,0,0" />
                        <TextBlock Text="{DynamicResource '柔和丁香'}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                      </StackPanel>
                    </RadioButton>
                  </UniformGrid>
                </StackPanel>
                <StackPanel Margin="0,18,0,0">
                  <TextBlock Text="{DynamicResource '明暗模式'}" Margin="0,0,0,12" FontSize="15" FontWeight="SemiBold" />
                  <UniformGrid Columns="3" Margin="0,0,-8,18">
                    <RadioButton x:Name="LightThemeRadio" GroupName="theme" Tag="light" Style="{StaticResource ThemeTile}" Checked="Theme_Changed" Margin="0,0,8,0">
                      <StackPanel>
                        <controls:SymbolIcon Kind="sun" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="{DynamicResource '浅色'}" HorizontalAlignment="Center" />
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="DarkThemeRadio" GroupName="theme" Tag="dark" Style="{StaticResource ThemeTile}" Checked="Theme_Changed" Margin="0,0,8,0">
                      <StackPanel>
                        <controls:SymbolIcon Kind="moon" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="{DynamicResource '深色'}" HorizontalAlignment="Center" />
                      </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SystemThemeRadio" GroupName="theme" Tag="system" Style="{StaticResource ThemeTile}" Checked="Theme_Changed" Margin="0,0,8,0">
                      <StackPanel>
                        <controls:SymbolIcon Kind="monitor" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="{DynamicResource '跟随系统'}" HorizontalAlignment="Center" />
                      </StackPanel>
                    </RadioButton>
                  </UniformGrid>
                </StackPanel>
                <TextBlock Text="{DynamicResource '即时预览；保存后保留，关闭窗口恢复已保存的外观。'}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,18" />
                <Border Style="{StaticResource CardFrame}" Background="{DynamicResource AccentSurfaceBrush}" Margin="0,0,0,18">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <controls:BrandMark Width="19" Height="19" Margin="0,0,7,0" />
                      <TextBlock Text="{DynamicResource '翻译浮窗预览'}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Enjoy the little things." FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,17,0,5" />
                    <TextBlock Text="{DynamicResource '享受生活中的小美好。'}" FontSize="20" FontWeight="Medium" />
                    <Grid Margin="0,15,0,0">
                      <TextBlock Text="{DynamicResource '配色将同步应用到设置、收藏和翻译浮窗。'}" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <controls:SymbolIcon Kind="copy" Width="14" Height="14" Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,0" />
                        <controls:SymbolIcon Kind="favorite" Width="14" Height="14" Foreground="{DynamicResource MutedBrush}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
                <controls:SettingCard Title="{DynamicResource '自动隐藏（秒）'}" Description="{DynamicResource '0 表示不自动隐藏；操作悬浮窗时保持显示'}">
                  <TextBox x:Name="AutoHideInput" Width="72" AutomationProperties.Name="{DynamicResource '自动隐藏（秒）'}" />
                </controls:SettingCard>
                <Border Background="{DynamicResource HoverBrush}" CornerRadius="8" Padding="14" Margin="0,12,0,4">
                  <TextBlock Text="{DynamicResource '阅读选区可预览、复制与收藏；可安全编辑的输入框还支持确认替换。'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                </Border>
                <TextBlock Text="{DynamicResource '浮窗显示'}" Style="{StaticResource SectionHeading}" />
                <controls:SettingCard Title="{DynamicResource '字体大小（10–32）'}" Description="{DynamicResource '调整悬浮窗中的译文字号'}">
                  <TextBox x:Name="FontInput" Width="72" AutomationProperties.Name="{DynamicResource '字体大小（10–32）'}" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '不透明度（0.4–1）'}">
                  <TextBox x:Name="OpacityInput" Width="72" AutomationProperties.Name="{DynamicResource '不透明度（0.4–1）'}" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '最大宽度（160–800）'}">
                  <TextBox x:Name="WidthInput" Width="72" AutomationProperties.Name="{DynamicResource '最大宽度（160–800）'}" />
                </controls:SettingCard>
                <TextBlock Text="{DynamicResource '悬浮窗位置'}" Style="{StaticResource SectionHeading}" />
                <controls:SettingCard Title="{DynamicResource '位置偏好'}" Description="{DynamicResource '优先放置在选中文字旁，空间不足时自动调整'}">
                  <ComboBox x:Name="PositionInput" AutomationProperties.Name="{DynamicResource '位置偏好'}" DisplayMemberPath="Label" SelectedValuePath="Code" />
                </controls:SettingCard>
                <Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,14,0,0">
                  <TextBlock Text="{DynamicResource '位置不足时依次尝试右、下、左、上；无法取得坐标时显示在屏幕角落。焦点离开、输入清空或暂停时自动隐藏。'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                </Border>
              </StackPanel>
              <StackPanel x:Name="PageHotkeys" Visibility="Collapsed">
                <controls:SettingCard Title="{DynamicResource '显示查询面板'}" Description="{DynamicResource '默认 Ctrl+Alt+T；划词模式仅翻译选区，其他模式可翻译输入当前行'}">
                  <TextBox x:Name="PreviewHotkey" Width="210" AutomationProperties.Name="{DynamicResource '显示查询面板'}" />
                </controls:SettingCard>
                <TextBlock Text="{DynamicResource '全局快捷键'}" Style="{StaticResource SectionHeading}" />
                <controls:SettingCard Title="{DynamicResource '准备替换 / 显示确认'}" Description="{DynamicResource '打开原文与译文确认，确认后才写入'}">
                  <TextBox x:Name="ReplaceHotkey" Width="240" AutomationProperties.Name="{DynamicResource '准备替换 / 显示确认'}" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '开启 / 暂停全部读取'}">
                  <TextBox x:Name="ToggleHotkey" Width="240" AutomationProperties.Name="{DynamicResource '开启 / 暂停全部读取'}" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '复制当前结果'}">
                  <TextBox x:Name="CopyHotkey" Width="240" AutomationProperties.Name="{DynamicResource '复制当前结果'}" />
                </controls:SettingCard>
                <Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,14,0,0">
                  <TextBlock Text="{DynamicResource '格式：Ctrl+Alt+Enter，可使用 Shift / Win。冲突会明确提示；不会监听所有按键。复制操作会按你的要求覆盖剪贴板；软件不会自动粘贴或模拟 Enter。'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                </Border>
              </StackPanel>
              <StackPanel x:Name="PageCache" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource '内存缓存'}" Style="{StaticResource SectionHeading}" />
                <controls:SettingCard Title="{DynamicResource '启用内存缓存'}" Description="{DynamicResource '相同内容优先复用译文，退出后自动释放'}">
                  <CheckBox x:Name="MemoryCheck" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="{DynamicResource '启用内存缓存'}" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '内存最大条目数'}">
                  <TextBox x:Name="MemoryCapacityInput" Width="72" AutomationProperties.Name="{DynamicResource '内存最大条目数'}" IsEnabled="{Binding IsChecked, ElementName=MemoryCheck}" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '内存有效期（分钟）'}">
                  <TextBox x:Name="MemoryTtlInput" Width="72" AutomationProperties.Name="{DynamicResource '内存有效期（分钟）'}" IsEnabled="{Binding IsChecked, ElementName=MemoryCheck}" />
                </controls:SettingCard>
                <TextBlock Text="{DynamicResource '本地磁盘'}" Style="{StaticResource SectionHeading}" />
                <controls:SettingCard Title="{DynamicResource '启用磁盘缓存'}" Description="{DynamicResource '默认关闭；开启后以加密形式保留译文'}">
                  <CheckBox x:Name="DiskCheck" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="{DynamicResource '启用磁盘缓存'}" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '磁盘最大条目数'}">
                  <TextBox x:Name="DiskCapacityInput" Width="72" AutomationProperties.Name="{DynamicResource '磁盘最大条目数'}" IsEnabled="{Binding IsChecked, ElementName=DiskCheck}" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '磁盘有效期（天）'}">
                  <TextBox x:Name="DiskTtlInput" Width="72" AutomationProperties.Name="{DynamicResource '磁盘有效期（天）'}" IsEnabled="{Binding IsChecked, ElementName=DiskCheck}" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '清除缓存'}" Description="{DynamicResource '同时清理内存和已保存的磁盘译文'}">
                  <Button Content="{DynamicResource '立即清除全部缓存'}" Click="ClearCache_Click" />
                </controls:SettingCard>
                <TextBlock Text="{DynamicResource '本次会话统计'}" Style="{StaticResource SectionHeading}" />
                <Border CornerRadius="6" Padding="18" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                  <TextBlock x:Name="StatisticsText" FontSize="13" LineHeight="26" />
                </Border>
                <Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,14,0,0">
                  <TextBlock Text="{DynamicResource '磁盘中的译文使用 DPAPI 加密；只保存输入哈希，不保存原文。关闭磁盘缓存不会自动删除已有内容，请使用清除按钮。日志不记录原文、译文或 Key。'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                </Border>
              </StackPanel>
              <StackPanel x:Name="PagePrivacy" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource '应用访问'}" Style="{StaticResource SectionHeading}" />
                <controls:SettingCard Title="{DynamicResource '监控所有应用'}" Description="{DynamicResource '覆盖全部可访问应用，无需逐一添加进程'}">
                  <CheckBox x:Name="AllApplicationsCheck" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="{DynamicResource '监控所有应用'}" Checked="Scope_Changed" Unchecked="Scope_Changed" />
                </controls:SettingCard>
                <controls:SettingCard x:Name="AllowedApplicationsCard" Title="{DynamicResource '允许的进程名'}" Description="{DynamicResource '关闭所有应用模式后，仅监控此列表'}">
                  <TextBox x:Name="AllowedInput" Width="240" AutomationProperties.Name="{DynamicResource '允许的进程名'}" Height="80" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '排除的进程名'}" Description="{DynamicResource '始终优先排除；用逗号或换行分隔进程名'}">
                  <TextBox x:Name="ExcludedInput" Width="240" AutomationProperties.Name="{DynamicResource '排除的进程名'}" Height="80" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                </controls:SettingCard>
                <TextBlock Text="{DynamicResource '授权与保护'}" Style="{StaticResource SectionHeading}" />
                <controls:SettingCard Title="{DynamicResource '隐私授权'}" Description="{DynamicResource '允许读取选区；在线任务发送选区、指令和问题给所选 AI，纯翻译按离线回退设置处理'}">
                  <CheckBox x:Name="ConsentCheck" MaxWidth="270" AutomationProperties.Name="{DynamicResource '隐私授权'}">
                    <TextBlock Text="{DynamicResource '我同意读取选区，并按所选任务发送内容给 AI'}" FontSize="13" TextWrapping="Wrap" />
                  </CheckBox>
                </controls:SettingCard>
                <controls:SettingCard Title="{DynamicResource '暂停所有读取'}" Description="{DynamicResource '立即停止读取与查询，并隐藏面板'}">
                  <Button Content="{DynamicResource '立即暂停'}" Click="Pause_Click" />
                </controls:SettingCard>
                <Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,14,0,0">
                  <TextBlock Text="{DynamicResource '密码框、敏感控件和排除列表始终跳过。仅支持公开文本选区的应用；不识别图片或扫描件。'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                </Border>
                <Border Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="6" Padding="16" Margin="0,14,0,0">
                  <TextBlock Text="{DynamicResource '纯翻译题库命中时不发送文本。百科等在线任务发送选区、指令与问题给所选 AI。核对翻译替换范围时会在本机临时读取编辑框全文。'}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                </Border>
              </StackPanel>
              <StackPanel x:Name="PageFavorites" Visibility="Collapsed">
                <Border Style="{StaticResource CardFrame}" Background="{DynamicResource AccentSurfaceBrush}" Margin="0,0,0,20">
                  <StackPanel>
                    <TextBlock Text="COLLECT A LITTLE. LEARN A LOT." Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="{DynamicResource '把新知识，留在本地。'}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource '主动收藏有用的回答和译文；保留原文与问题，仅在本机加密保存。'}" Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,13" FontSize="11" />
                    <TextBlock x:Name="FavoritesCountText" FontSize="13" Margin="0,0,0,12" />
                    <WrapPanel Margin="0,5,0,0">
                      <Button x:Name="StartReviewButton" Content="{DynamicResource '开始到期复习'}" Click="StartReview_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4" />
                      <Button Content="{DynamicResource '刷新收藏'}" Click="RefreshFavorites_Click" Margin="0,0,0,4" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border x:Name="ReviewPanel" Visibility="Collapsed" Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="14" Padding="24" Margin="0,0,0,18" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                  <StackPanel>
                    <TextBlock x:Name="ReviewProgressText" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12" FontSize="11" />
                    <ProgressBar x:Name="ReviewProgressBar" Height="3" Minimum="0" Maximum="1" Value="0" Margin="0,0,0,14" AutomationProperties.Name="{DynamicResource '复习进度'}" />
                    <TextBlock x:Name="ReviewOriginalText" FontSize="24" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock x:Name="ReviewTranslationText" FontSize="18" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,14,0,0" />
                    <Button x:Name="ShowAnswerButton" Content="{DynamicResource '显示答案'}" Click="ShowAnswer_Click" HorizontalAlignment="Left" Margin="0,16,0,0" Style="{StaticResource PrimaryButton}" />
                    <WrapPanel x:Name="ReviewRatingPanel" Visibility="Collapsed" Margin="0,16,0,0">
                      <Button x:Name="ReviewAgainButton" Content="{DynamicResource '再练一次'}" Click="ReviewAgain_Click" Margin="0,0,8,4" />
                      <Button x:Name="ReviewRememberedButton" Content="{DynamicResource '记住了'}" Click="ReviewRemembered_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,0,4" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <TextBlock Text="{DynamicResource '搜索本地收藏'}" FontSize="12" Margin="0,0,0,8" />
                <TextBox x:Name="FavoritesSearchInput" TextChanged="FavoritesSearch_TextChanged" AutomationProperties.Name="{DynamicResource '搜索本地收藏'}" ToolTip="{DynamicResource '搜索本地收藏'}" Margin="0,0,0,12" />
                <Border x:Name="FavoritesEmptyPanel" Style="{StaticResource CardFrame}" Padding="24" Margin="0,0,0,16">
                  <StackPanel>
                    <controls:SymbolIcon Kind="favorite" Width="30" Height="30" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,14" />
                    <TextBlock x:Name="FavoritesEmptyText" Text="{DynamicResource '暂无匹配的收藏；翻译后点击星标即可保存。'}" Foreground="{DynamicResource MutedBrush}" Margin="0" HorizontalAlignment="Center" TextAlignment="Center" />
                  </StackPanel>
                </Border>
                <ListBox x:Name="FavoritesList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{DynamicResource '本地收藏与复习'}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18" HorizontalAlignment="Stretch" Background="{DynamicResource CardBrush}" CornerRadius="12" Margin="0,0,0,8">
                        <StackPanel>
                          <TextBlock Text="{Binding Original}" TextWrapping="Wrap" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Question}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                          <TextBlock Text="{Binding Translation}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
                          <WrapPanel Margin="0,8,0,0">
                            <Button Content="{DynamicResource '复制结果'}" Click="CopyFavorite_Click" Tag="{Binding}" Margin="0,0,8,0" FontSize="11" MinHeight="30" Padding="10,5" />
                            <Button Content="{DynamicResource '删除收藏'}" Click="DeleteFavorite_Click" Tag="{Binding}" FontSize="11" MinHeight="30" Padding="10,5" />
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Grid>
          </ScrollViewer>
          <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,8,17">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="MessageText" FontSize="11" Foreground="{DynamicResource TextBrush}" Margin="0,0,10,3" />
                <TextBlock Text="{DynamicResource '更改设置后点击保存；关闭窗口仍在托盘运行'}" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
              <Button x:Name="SaveSettingsButton" Grid.Column="1" Content="{DynamicResource '保存设置'}" Click="Save_Click" Style="{StaticResource PrimaryButton}" MinWidth="108" Margin="16,0,0,0" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
