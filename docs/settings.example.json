{
  "UiLanguage": "zh-CN",
  "PrivacyConsent": false,
  "AI": {
    "Provider": "DeepSeek",
    "BaseUrl": "https://api.deepseek.com",
    "Model": "deepseek-flash",
    "TimeoutSeconds": 20,
    "MaxRetries": 2
  },
  "Translation": {
    "Enabled": true,
    "DebounceMilliseconds": 500,
    "MinimumRequestIntervalMilliseconds": 700,
    "MaxInputCharacters": 2000,
    "SourceLanguage": "auto",
    "TargetLanguage": "ja",
    "Mode": "natural"
  },
  "Cache": {
    "MemoryEnabled": true,
    "MemoryMaxEntries": 500,
    "MemoryTTLMinutes": 30,
    "DiskEnabled": false,
    "DiskMaxEntries": 5000,
    "DiskTTLDays": 7
  },
  "Overlay": {
    "DarkMode": false,
    "FontSize": 14,
    "Opacity": 0.88,
    "MaxWidth": 320,
    "Position": "above",
    "Theme": "system",
    "TriggerMode": "typing",
    "AutoHideSeconds": 8,
    "ShowLoading": true
  },
  "Hotkeys": {
    "Replace": "Ctrl+Alt+Enter",
    "Toggle": "Ctrl+Alt+Space",
    "Copy": "Ctrl+Alt+C",
    "Preview": "Ctrl+Alt+T"
  },
  "AllowedApplications": [],
  "ExcludedApplications": [
    "1password",
    "keepass",
    "keepassxc",
    "bitwarden"
  ],
  "MonitorAllApplications": true
}
